rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function own(uid) {return request.auth != null && request.auth.uid == uid;}
   function verified() {return request.auth != null && request.auth.token.email_verified == true;}
   function activeUser(uid) {
    let profile=get(/databases/$(database)/documents/users/$(uid)).data;
    return profile.role in ['owner','shop'] && (!('accountStatus' in profile) || profile.accountStatus == 'active');
   }
    function adminUser() {
     let profile=request.auth == null ? {} : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
     return verified() && request.auth.token.admin == true && profile.role == 'admin'
      && (!('accountStatus' in profile) || profile.accountStatus == 'active')
      && !('statusOperation' in profile) && !('provisioningOperation' in profile);
   }
  // Own onboarding profile remains readable while unverified/restricted so the
  // app can show status and recover setup. It grants no privileged operations.
  // All sensitive metadata/catalogue reads go through revoked-token-aware API.
  match /users/{uid} {
   allow get: if own(uid);
   allow list, create, update, delete: if false;
   match /documents/{kind} {
    allow read: if false;
    allow write: if false;
   }
   match /savedPosts/{postId} {
    allow get, list: if own(uid) && verified() && activeUser(uid);
    allow create: if own(uid) && verified() && activeUser(uid)
     && request.resource.data.keys().hasOnly(['postId','createdAt'])
     && request.resource.data.postId == postId && request.resource.data.createdAt is timestamp
     && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published';
    allow delete: if own(uid) && verified() && activeUser(uid);
    allow update: if false;
   }
  }
  match /posts/{postId} {
   allow get, list: if verified() && activeUser(request.auth.uid) && resource.data.status == 'published';
   // All post writes go through the authenticated API, which enforces shop
   // ownership, validates uploaded storage objects and records audit events.
   allow create, delete: if false;
   allow update: if false;
   allow update: if adminUser()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && request.resource.data.status == 'removed';
  }
  match /serviceCategories/{id} {
   allow read: if false;
   allow write: if false;
  }
 }
}
