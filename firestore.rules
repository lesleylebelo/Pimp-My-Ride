rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function own(uid) {return request.auth != null && request.auth.uid == uid;}
  function verifiedActive() {
   return request.auth != null && request.auth.token.email_verified == true
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus','active') == 'active';
  }
  match /users/{uid} {
   allow get: if own(uid);
   allow list, create, update, delete: if false;
   match /documents/{kind} {
    allow read: if own(uid) && verifiedActive();
    allow write: if false;
   }
  }
  match /serviceCategories/{id} {
   allow read: if verifiedActive();
   allow write: if false;
  }
 }
}
