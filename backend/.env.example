NODE_ENV=production
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
FIREBASE_PROJECT_ID=pimp-my-ride-a26fc
# JSON service-account credential: configure as a secret on Render, never commit its value.
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only secret key (or legacy service_role key); never use EXPO_PUBLIC_ for this.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=verification
# Separate private bucket for vehicle/request photos; server-only configuration.
SUPABASE_PHOTO_BUCKET=vehicle-images
SUPABASE_REQUEST_BUCKET=request-images
SUPABASE_POSTS_BUCKET=showcase-images
SUPABASE_LEGACY_PHOTO_BUCKET=marketplace-photos
SUPABASE_LEGACY_POSTS_BUCKET=public-posts

# PimpPilot production service. Configure the provider/key, then enable explicitly.
# Server-side only; never prefix these names with EXPO_PUBLIC_.
PMR_AI_ASSIST_ENABLED=false
# Explicit selection; never falls back to another provider.
PMR_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Explicitly supported: gemini-3.5-flash-lite and legacy gemini-2.5-flash-lite.
# All other providers/models fail closed; selection never falls back.
PMR_AI_MODEL=gemini-3.5-flash-lite
# Every eligible Customer and approved Workshop can generate; no tester UID or generation-count settings.
# Historical tester variables are ignored and may be removed after the new backend is deployed.
