{
  "name": "pimpmyride",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "node scripts/build-web.cjs",
    "verify:web": "node scripts/verify-web-export.cjs dist",
    "test": "node --test tests/*.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pmr-security \"node --test tests/rules/*.test.cjs\"",
    "test:security": "firebase emulators:exec --only auth,firestore --project demo-pmr-security \"node scripts/test-emulators.cjs\"",
    "test:backend": "npm test --prefix backend",
    "seed:categories": "node scripts/seed-categories.cjs",
    "migrate:showcase-posts": "node scripts/migrate-showcase-posts.cjs",
    "backfill:quotation-counts": "node scripts/backfill-quotation-counts.cjs",
    "cleanup:report": "node scripts/cleanup-storage.cjs",
    "cleanup:photos": "node scripts/cleanup-photos.cjs",
    "test:google-auth": "node --test --test-concurrency=2 tests/google-android-identity.test.cjs tests/google-android-ui.test.cjs tests/google-route-contract.test.cjs tests/google-accounts.test.cjs tests/google-ui.test.cjs tests/accounts.test.cjs tests/auth.test.cjs tests/firebase-isolation.test.cjs tests/session.test.cjs tests/storage.test.cjs tests/verification-ui.test.cjs tests/password-recovery.test.cjs backend/test/google-auth.test.cjs backend/test/http.test.cjs backend/test/security.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "cors": "^2.8.6",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.19",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "babel-preset-expo": "~57.0.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.1",
    "react-test-renderer": "^19.2.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "decode-uri-component": "$decode-uri-component"
  }
}
