rules_version = '2';
// Historical Firebase Storage rules, not deployed by firebase.json. Current
// uploads use the Express API and private Supabase Storage. Check live legacy
// usage before retiring any old bucket/rules; do not deploy this file as setup.
service firebase.storage {
 match /b/{bucket}/o {
  function own(uid) {return request.auth != null && request.auth.uid == uid;}
  function verified() {return request.auth != null && request.auth.token.email_verified == true;}
  function activeData(profile) {return !('accountStatus' in profile) || profile.accountStatus == 'active';}
  function active(uid) {return activeData(firestore.get(/databases/(default)/documents/users/$(uid)).data);}
  function pendingShop(uid) {
   let profile = firestore.get(/databases/(default)/documents/users/$(uid)).data;
   return activeData(profile) && profile.role == 'shop' && profile.verificationStatus == 'pending';
  }
  match /verification/{uid}/{kind} {
   allow read: if own(uid) && verified() && active(uid);
   allow create, update: if own(uid) && verified() && pendingShop(uid)
    && kind in ['cipcCert','proofOfAddress','ownerId']
    && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
    && request.resource.contentType in ['application/pdf','image/jpeg','image/png'];
   allow delete: if own(uid) && verified() && pendingShop(uid);
  }
 }
}
